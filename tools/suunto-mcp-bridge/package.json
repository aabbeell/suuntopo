{
  "name": "suunto-mcp-bridge",
  "displayName": "SuuntoPlus MCP Bridge",
  "description": "Exposes the SuuntoPlus Editor build and simulator to Claude Code over MCP (localhost only)",
  "version": "0.1.5",
  "publisher": "aabbeell",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "SuuntoPlus MCP Bridge",
      "properties": {
        "suuntoMcpBridge.port": {
          "type": "number",
          "default": 39317,
          "description": "Localhost port the MCP server listens on"
        }
      }
    }
  }
}
